        ],
        "beats": [
          {
            "t": 5,
            "who": "",
            "text": "滄嵐山的雲階，一級一級，走向被咒的將軍。鐵僧攔路，鐘聲當盾。"
          },
          {
            "t": 26,
            "who": "魯智深",
            "text": "「同是出家人，你的鐘渡不了他。讓我的杖試試。」"
          },
          {
            "t": 44,
            "who": "",
            "text": "雲裡落石，風裡藏刀。走一步，還一步。"
          },
          {
            "t": 62,
            "who": "",
            "text": "雲階盡頭，一把方天畫戟插在石裡——戟的主人，眼睛是灰色的。"
          }
        ],
        "shots": [
