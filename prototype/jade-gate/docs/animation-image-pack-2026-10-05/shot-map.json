    "scene": "refuse",
    "shotIndex": 2,
    "kind": "closeup",
    "localTime": 28,
    "episodeTime": 398,
    "request": "ep2-refuse-s02",
    "output": "assets/animation/shot/ep2-refuse-s02.png",
    "sourceBeat": "「開屏吧——第一輪。」"
  },
  {
