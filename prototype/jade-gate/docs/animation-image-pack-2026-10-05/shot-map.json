    "scene": "final-duel",
    "shotIndex": 4,
    "kind": "fight",
    "localTime": 62,
    "episodeTime": 1287,
    "request": "ep1-final-duel-s04",
    "output": "assets/animation/shot/ep1-final-duel-s04.png",
