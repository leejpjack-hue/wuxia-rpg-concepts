    "episodeTime": 157.5,
    "request": "ep1-prologue-s05",
    "output": "assets/animation/shot/ep1-prologue-s05.png",
    "sourceBeat": "「山河有盡，寸刃不移。這一次，換我們守門。」"
  },
  {
    "episode": "ep1",
    "scene": "prologue",
    "shotIndex": 6,
